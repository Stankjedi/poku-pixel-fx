function glyph(name: string, rows: string, unicode: number[] = []): TTF.Glyph {
  const contours: TTF.Contour[] = [];
  const lines = rows.split("/");
  if (lines.length !== 7 || lines.some((line) => !/^[01]{5}$/.test(line))) throw new Error(`Invalid glyph pattern: ${name}`);
  for (let y = 0; y < lines.length; y++) {
    for (let x = 0; x < lines[y].length; x++) {
      if (lines[y][x] !== "1") continue;
      const x0 = 50 + x * 120, y0 = 80 + (6 - y) * 120;
      contours.push([
        { x: x0, y: y0, onCurve: true }, { x: x0, y: y0 + 120, onCurve: true },
        { x: x0 + 120, y: y0 + 120, onCurve: true }, { x: x0 + 120, y: y0, onCurve: true },
      ]);
    }
  }
  const points = contours.flat();
  return { name, unicode, contours, advanceWidth: 720, leftSideBearing: 0,
    xMin: points.length ? Math.min(...points.map((point) => point.x)) : 0,
    yMin: points.length ? Math.min(...points.map((point) => point.y)) : 0,
    xMax: points.length ? Math.max(...points.map((point) => point.x)) : 0,
    yMax: points.length ? Math.max(...points.map((point) => point.y)) : 0 };
}

const font = createFont();
const ttf = font.get();
ttf.glyf = [
  glyph(".notdef", "11111/10001/10101/10101/10101/10001/11111"),
  glyph("space", "00000/00000/00000/00000/00000/00000/00000", [32]),
  ...Object.entries(patterns).map(([character, rows]) => {
    const code = character.codePointAt(0)!;
    return glyph(`uni${code.toString(16).toUpperCase().padStart(4, "0")}`, rows, [code]);
  }),
];
Object.assign(ttf.head, { unitsPerEm: 1000 });
Object.assign(ttf.hhea, { ascent: 950, descent: -200, lineGap: 0 });
Object.assign(ttf["OS/2"], { sTypoAscender: 950, sTypoDescender: -200, sTypoLineGap: 0, usWinAscent: 950, usWinDescent: 200 });
Object.assign(ttf.name, { fontFamily: "Poku Pixel", fontSubFamily: "Regular", uniqueSubFamily: "Poku Pixel 1.0",
  fullName: "Poku Pixel Regular", postScriptName: "PokuPixel-Regular", version: "Version 1.0" });
font.set(ttf);
const output = process.argv[2] ? resolve(process.argv[2]) : resolve(dirname(fileURLToPath(import.meta.url)), "../../gallery/fonts/PokuPixel-Regular.ttf");
writeFileSync(output, font.write({ type: "ttf", toBuffer: true }));
console.log(`폰트 생성 완료: ${output}`);
