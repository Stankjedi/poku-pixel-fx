#!/usr/bin/env node
// Regenerate the registry (src/fx/index.js) and the catalog (docs/CATALOG.md) from the effect files.
//
//   node build-tools/tools/index.mjs

import { writeFileSync, readFileSync } from "node:fs";
import { join } from "node:path";
import { ROOT, FX_DIR, allIds, loadEffect, effectSymbol } from "./lib/fxlib.mjs";
const { categories } = await import(new URL("../../build/fx/categories.js", import.meta.url).href);

type Metadata = { id: string; name: string; size: number[]; loop: boolean; duration: number; desc: string };
const metas: Metadata[] = [];
for (const id of allIds()) {
  try {
    const meta = (await loadEffect(id)).meta;
    metas.push({ id, name: meta.name, size: meta.size, loop: meta.loop, duration: meta.duration, desc: meta.desc });
  } catch (e) {
    throw new Error(`레지스트리를 생성할 수 없습니다: ${id}: ${String(e instanceof Error ? e.message : e).split("\n")[0]}. 인덱스를 생성하기 전에 npm run build를 실행하세요.`);
  }
}
const ids = metas.map((m) => m.id);
const order = new Map<string, number>(categories.map((c: {id: string}, i: number) => [c.id, i]));
const rank = (id: string) => order.get(id.split("/")[0]) ?? 99;
ids.sort((a, b) => rank(a) - rank(b) || a.localeCompare(b));
metas.sort((a, b) => rank(a.id) - rank(b.id) || a.id.localeCompare(b.id));

const ident = effectSymbol;
const lines = [
  "// Generated by tools/index.mjs: every effect, by id. Don't edit; run `node build-tools/tools/index.mjs`.",
  "",
  ...ids.map((id) => `import * as ${ident(id)} from "./${id}.js";`),
  "",
  `export { categories } from "./categories.js";`,
  "",
  "export const effects = {",
  ...ids.map((id) => `  "${id}": ${ident(id)},`),
  "};",
  "",
];
writeFileSync(join(FX_DIR, "index.ts"), lines.join("\n"));

const md = [
  "# Catalog",
  "",
  `${ids.length} effects in ${categories.filter((c: {id: string}) => metas.some((m) => m.id.startsWith(c.id + "/"))).length} categories. Every one is a file in`,
  "`src/fx/<category>/<name>.ts`; render any of them with `node build-tools/tools/render.mjs <id> --gif`.",
  "",
];
for (const c of categories as Array<{id: string; name: string; blurb: string}>) {
  const list = metas.filter((m) => m.id.startsWith(c.id + "/"));
  if (!list.length) continue;
  md.push(`## ${c.name}`, "", `${c.blurb}.`, "", "| effect | id | | size | what it does |", "|---|---|---|---|---|");
  for (const m of list)
    md.push(`| ${m.name} | \`${m.id}\` | ${m.loop ? "loop" : "one-shot"} ${+m.duration.toFixed(2)}s | ${m.size[0]}×${m.size[1]} | ${m.desc.replace(/\|/g, "\\|")} |`);
  md.push("");
}
writeFileSync(join(ROOT, "docs", "CATALOG.md"), md.join("\n"));
console.log(`이펙트 ${ids.length}개 -> src/fx/index.ts, docs/CATALOG.md (npm run build 실행)`);

// README: the count and the category table
const readme = join(ROOT, "README.md");
const rows = (categories as Array<{id: string; name: string}>)
  .map((c: {id: string; name: string}) => [c, metas.filter((m) => m.id.startsWith(c.id + "/"))] as const)
  .filter(([, list]) => list.length)
  .map(([c, list]) => `| **${c.name}** | ${list.length} | ${list.slice(0, 6).map((m) => m.name.toLowerCase()).join(", ")}${list.length > 6 ? "…" : ""} |`);
const table = ["| category | effects | some of them |", "|---|---|---|", ...rows].join("\n");
let text = readFileSync(readme, "utf8");
text = text.replace(/<!-- count -->[\s\S]*?<!-- \/count -->/, `<!-- count -->${ids.length}<!-- /count -->`);
text = text.replace(/<!-- catalog -->[\s\S]*?<!-- \/catalog -->/, `<!-- catalog -->\n${table}\n<!-- /catalog -->`);
writeFileSync(readme, text);

