{
  "name": "poku-pixel-fx",
  "version": "0.3.0",
  "description": "Code-driven pixel art effects and animations, and a Claude Code skill to make your own.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=18" },
  "exports": {
    ".": { "types": "./build/index.d.ts", "import": "./build/index.js" },
    "./fx/*": { "types": "./build/fx/*.d.ts", "import": "./build/fx/*.js" },
    "./core/*": { "types": "./build/core/*.d.ts", "import": "./build/core/*.js" },
    "./3d": { "types": "./build/3d/index.d.ts", "import": "./build/3d/index.js" },
    "./3d/*": { "types": "./build/3d/*.d.ts", "import": "./build/3d/*.js" },
    "./3d/effects/*": { "types": "./build/3d/effects/*.d.ts", "import": "./build/3d/effects/*.js" }
  },
  "scripts": {
    "render": "node build-tools/tools/render.mjs",
    "check": "node build-tools/tools/check.mjs",
    "gallery": "node build-tools/tools/serve.mjs",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.gallery.json && esbuild gallery/app.ts --bundle --format=esm --outfile=build-gallery/app.js && esbuild gallery/3d.ts --bundle --format=esm --outfile=build-gallery/3d.js",
    "prepack": "npm run build",
    "font": "node build-tools/tools/make-poku-font.mjs",
    "share": "node build-tools/tools/share.mjs",
    "catalog": "node build-tools/tools/export-catalog.mjs",
    "sync:site": "npm run build && node build-tools/tools/sync-site.mjs",
    "render:3d": "node build-tools/tools/render-3d.mjs",
    "render:3d:gif": "node build-tools/tools/render-3d-gif.mjs",
    "test:3d": "node --test tests/3d.test.mjs tests/black-hole-3d.test.mjs tests/cinematic.test.mjs tests/wind-rasenshuriken-3d.test.mjs tests/unified-vfx.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.10",
    "fonteditor-core": "^2.6.3",
    "typescript": "^7.0.2"
  },
  "files": ["build", "LICENSE", "NOTICE.md", "licenses"]
}
