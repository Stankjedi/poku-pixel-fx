{
  "name": "poku-pixel-fx",
  "version": "0.3.0",
  "description": "Code-driven pixel art effects and animations, and a Claude Code skill to make your own.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./fx/*": {
      "types": "./build/fx/*.d.ts",
      "import": "./build/fx/*.js"
    },
    "./core/*": {
      "types": "./build/core/*.d.ts",
      "import": "./build/core/*.js"
    }
  },
  "scripts": {
    "render": "node build-tools/tools/render.mjs",
    "check": "node build-tools/tools/check.mjs",
    "gallery": "node build-tools/tools/serve.mjs",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.gallery.json && esbuild gallery/app.ts --bundle --format=esm --outfile=build-gallery/app.js",
    "prepack": "npm run build",
    "font": "node build-tools/tools/make-poku-font.mjs",
    "share": "node build-tools/tools/share.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.10",
    "fonteditor-core": "^2.6.3",
    "typescript": "^7.0.2"
  },
  "files": [
    "build",
    "LICENSE",
    "NOTICE.md",
    "licenses"
  ]
}
